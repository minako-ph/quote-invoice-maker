# backend/.env.example — ライセンス専用バックエンド(Cloud Run)環境変数（引継書§9）
#
# 使い方: cp backend/.env.example backend/.env して値を埋める（.envはgitignore済み）。
# 本番はCloud Runのenv/Secret Managerで設定し、シークレット値をコード・リポジトリ・ログに
# 含めない（CR-5絶対規則）。
#
# ※ GAS側の設定はここではなく Script Properties で行う（引継書§9）: BACKEND_URL のみ。

# --- Stripe（FR-10 ライセンス。¥1,480税込のProプラン） ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- ライセンスキー署名（Ed25519 JWT: sub=stripe customer。引継書§7） ---
# PKCS8 PEM の秘密鍵。**柱3（company-list-cleaner）とは別の新規ペア**を使うこと（引継書§2）。
# 導出手順は backend/README.md 参照（openssl genpkey -algorithm ed25519）。
LICENSE_SIGNING_KEY=

# --- listen ポート（Cloud Run が注入。ローカル既定 8080） ---
PORT=8080
